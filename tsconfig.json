{
	"compilerOptions": {
		"incremental": true,
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "commonjs",
		"moduleResolution": "node",
		"baseUrl": "./src",
		"declaration": true,
		"sourceMap": true,
		"outDir": "./dist",
		"removeComments": true,
		"noEmitOnError": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"exclude": ["node_modules", "dist"]
}
